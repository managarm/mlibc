[properties]
skip_sanity_check = true

[binaries]
c = 'riscv64-linux-gnu-gcc'
cpp = 'riscv64-linux-gnu-g++'
exe_wrapper = 'qemu-riscv64'

[host_machine]
system = 'linux'
cpu_family = 'riscv64'
cpu = 'unknown'
endian = 'little'

[built-in options]
c_args = ['-mno-relax']
cpp_args = ['-mno-relax']
c_link_args = ['-mno-relax']
cpp_link_args = ['-mno-relax']
